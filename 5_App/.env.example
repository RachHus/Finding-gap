# 5_App 환경변수 템플릿 — 실제 값은 .env 에 넣는다(.env 는 git 제외).
# 복사: cp 5_App/.env.example 5_App/.env  후 값 채우기
#
# 여기 값들은 build_dist.py(또는 _make_config.py)가 읽어 클라이언트용 config.js 로 굽는다.
# config.js 는 브라우저에 그대로 노출되므로, 노출돼도 되는 키만 둔다.

# ── 배경지도 ──
# vworld WMS 인증키 (https://www.vworld.kr). 사용 도메인 등록 필요(localhost·배포 도메인).
# 클라이언트에서 호출하므로 노출된다 — 도메인(Referer) 잠금으로만 보호된다. 비우면 OSM 만 쓴다.
VWORLD_KEY=

# ── Supabase (로그인·제보·관심종·대화형 도우미) ──
# publishable 키만 쓴다. RLS 로 보호되는 전제이므로 클라이언트 노출이 허용된다.
# 관리자 권한 키(대시보드의 secret 키)는 이 파일에도, config.js 에도, 저장소 어디에도
# 넣지 않는다. 그 키는 RLS 를 통째로 무시하므로, 새어 나가면 남의 제보까지 다 읽힌다.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# 참조데이터 적재용 Postgres 직결 URI (5_App/supabase/load_reference.py 전용).
# Supabase Dashboard → Project Settings → Database → Connection string.
# Direct 또는 Session pooler 를 쓴다(Transaction pooler 6543 은 준비문을 못 써 안 된다).
# 빌드 타임 전용 — config.js 에 굽히지 않는다.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# 대화형 도우미 노출 스위치. 백엔드(chat Edge Function)가 준비되기 전엔 비워 둔다.
CHAT_ENABLED=

# ── 사용 통계 ──
# GA4 측정 ID(G-XXXXXXX). 비우면 분석 스크립트를 아예 싣지 않는다.
GA4_MEASUREMENT_ID=

# ── 국립생물자원관 디지털 자료관 API (종 사진·세밀화) ──
# 발급: https://species.nibr.go.kr (OPEN API 신청 → 인증키 oapiAcsUnqNo + 접근 서버 IP 등록)
# 빌드타임 전용 — build_media_nibr.py 만 읽는다. config.js(클라이언트)에 절대 주입하지 않는다.
# IP 화이트리스트가 걸려 있어 신청한 IP(빌드 PC)에서만 호출된다.
NIBR_DIGITAL_API_KEY=YOUR_OAPI_ACS_UNQ_NO
# 엔드포인트는 명세에 운영(species.nibr.go.kr)·상세표(msaspecies.coreit.co.kr)가 섞여 있다.
# 신청 시 확정된 값을 넣고, 비우면 스크립트가 후보를 차례로 찔러 본다.
NIBR_DIGITAL_API_URL=
